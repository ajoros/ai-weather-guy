#!/bin/sh
# Strip Cursor / LLM attribution. Cursor may inject it after the agent
# writes the message; this hook is the lock the rule cannot be.
set -e
file="$1"
tmp="${file}.strip"
awk '
{
  low = tolower($0)
  if (low ~ /made[- ]with:[[:space:]]*cursor/) next
  if (low ~ /made with cursor/) next
  if (low ~ /generated by cursor/) next
  if (low ~ /co-authored-by:/ && low ~ /cursor/) next
  if (low ~ /via cursor/) next
  if ($0 ~ /^[[:space:]]*🤖/) next
  print
}
' "$file" > "$tmp"
mv "$tmp" "$file"
